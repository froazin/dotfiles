{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|Edit|Write|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$(if ($env:CLAUDE_CONFIG_DIR) { $env:CLAUDE_CONFIG_DIR } else { \"$HOME\\.claude\" })\\hooks\\no_session_links.ps1\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Glob|Grep|Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$(if ($env:CLAUDE_CONFIG_DIR) { $env:CLAUDE_CONFIG_DIR } else { \"$HOME\\.claude\" })\\hooks\\wow_marker.ps1\" pre-tool",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$(if ($env:CLAUDE_CONFIG_DIR) { $env:CLAUDE_CONFIG_DIR } else { \"$HOME\\.claude\" })\\hooks\\wow_marker.ps1\" pre-skill",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$(if ($env:CLAUDE_CONFIG_DIR) { $env:CLAUDE_CONFIG_DIR } else { \"$HOME\\.claude\" })\\hooks\\wow_marker.ps1\" post-bash",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$(if ($env:CLAUDE_CONFIG_DIR) { $env:CLAUDE_CONFIG_DIR } else { \"$HOME\\.claude\" })\\hooks\\wow_marker.ps1\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$(if ($env:CLAUDE_CONFIG_DIR) { $env:CLAUDE_CONFIG_DIR } else { \"$HOME\\.claude\" })\\hooks\\wow_marker.ps1\" subagent-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$(if ($env:CLAUDE_CONFIG_DIR) { $env:CLAUDE_CONFIG_DIR } else { \"$HOME\\.claude\" })\\hooks\\wow_marker.ps1\" expand",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$(if ($env:CLAUDE_CONFIG_DIR) { $env:CLAUDE_CONFIG_DIR } else { \"$HOME\\.claude\" })\\hooks\\wow_marker.ps1\" session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
