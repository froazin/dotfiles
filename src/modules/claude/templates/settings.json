{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [],
    "deny": [
      "Read(*.env)",
      "Read(*.env.*)",
      "Read(*.pem)",
      "Read(*.crt)",
      "Read(*.key)",
      "Read(~/.ssh/**)"
    ]
  },
  "model": "claude-opus-5-5",
  "theme": "auto",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true
}
