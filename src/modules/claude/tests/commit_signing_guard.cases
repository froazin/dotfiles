# --- git clone: -ckey=value and abbreviations of --config
deny git clone --co commit.gpgsign=false /r /tmp/clone
deny git clone --con=commit.gpgsign=false /r /tmp/clone
deny git clone -ccommit.gpgsign=false /r /tmp/clone
allow git clone --config core.autocrlf=false /r /tmp/clone
