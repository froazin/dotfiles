# --- Post events
lock PostToolUseFailure git commit -m x ||| Exit code 128\nerror: 1Password: failed to fill whole buffer\n\nfatal: failed to write commit object
lock PostToolUseFailure git commit -m x ||| Exit code 128\nerror: \nfatal: failed to write commit object
lock PostToolUseFailure git cherry-pick abc ||| Exit code 128\nerror: agent returned an error\nerror: failed to write commit object\nfatal: cherry-pick failed
lock PostToolUseFailure git rebase main ||| Exit code 1\nRebasing (1/1)\rerror: 1Password: failed to fill whole buffer\nerror: failed to write commit object
lock PostToolUseFailure git tag -s v1 -m v1 ||| Exit code 128\nerror: 1Password: x\nerror: unable to sign the tag
lock PostToolUseFailure git commit -m x ||| Command timed out after 2m 0s
lock PostToolUse git commit -m x; echo rc=$? ||| error: 1Password: failed to fill whole buffer\nfatal: failed to write commit object\nrc=128
lock PostToolUseFailure make release ||| Exit code 2\nerror: gpg failed to sign the data:\n(no gpg output)\nfatal: failed to write commit object
lock PostToolUseFailure git push --signed origin main ||| Exit code 128\nfatal: failed to sign the push certificate
none PostToolUseFailure git commit -m x ||| Exit code 1\nOn branch main\nnothing to commit, working tree clean
none PostToolUseFailure git commit -m x ||| Exit code 1\npre-commit hook failed\nshellcheck: SC2086
none PostToolUseFailure git commit --allow-empty -m x ||| Exit code 128\nerror: insufficient permission for adding an object to repository database .git/objects\nfatal: failed to write commit object
none PostToolUse cat ~/.claude/hooks/commit_signing_guard.py ||| def signing_failure: "unable to sign the tag|1Password|failed to write commit object"
none PostToolUse grep -rn 1Password README.md ||| README.md:12: 1Password SSH agent
none PostToolUseFailure npm test ||| Exit code 1\nCommand timed out after 2m 0s
none PostToolUse git commit -m x ||| [main abc123] x\n 1 file changed
none PostToolUse git commit -m "fix(api): retry when the upstream request timed out" ||| [main b082e19] fix(api): retry when the upstream request timed out\n 1 file changed
none PostToolUse git commit -m "feat: 1Password support via op-ssh-sign" ||| [main b082e19] feat: 1Password support via op-ssh-sign\n 1 file changed
none PostToolUseFailure git add -A && git commit -m "fix: x" && git push ||| Exit code 128\n[main 1a2b3c4] fix: x\nssh: connect to host github.com port 22: Connection timed out\nfatal: Could not read from remote repository.
none PostToolUseFailure git pull ||| Exit code 1\nssh: connect to host github.com port 22: Connection timed out
none PostToolUseFailure npx vitest run && git add -A && git commit -m "feat: y" ||| Exit code 1\nError: Test timed out in 5000ms.
none PostToolUseFailure diff -u old-rules.md rules/commit-signing.md ||| Exit code 1\n-  1Password with Windows Hello)\n+  1Password with Windows Hello).
none PostToolUseFailure cat README.md missing.txt ||| Exit code 1\nuse 1Password for signing\ncat: missing.txt: No such file or directory
lock PostToolUseFailure git rebase main ||| Exit code 1\nRebasing (1/1)\rerror: 1Password: failed to fill whole buffer\nerror: failed to write commit object

# --- Quoting and message text
deny git commit -m "Fix A & B" --no-gpg-sign
deny git commit -m "feat: add x; tidy y" --no-gpg-sign
deny git commit -m "fix: handle a|b" --no-gpg-sign
deny git merge feature -m "Merge a & b" --no-gpg-sign
deny git tag -a v1 -m "v1; first" --no-sign
deny git commit -am "$(cat <<'EOF'{NL}test: unsigned commit{NL}{NL}Body line with don't.{NL}EOF{NL})" --no-gpg-sign
deny git commit -m x \{NL}  --no-gpg-sign
deny git -c \{NL} commit.gpgsign=false commit -m x
allow git commit -m x \{NL}  -S
allow git commit -m "$(cat <<'EOF'{NL}feat(claude): deny --no-gpg-sign, git -c commit.gpgsign=false and HOME=/x overrides{NL}{NL}State lives in $XDG_RUNTIME_DIR/claude-commit-signing; ~/.gitconfig is never touched.{NL}EOF{NL})"
allow gh pr create --title "guard" --body "Blocks git commit --no-gpg-sign and git config --global --unset commit.gpgsign"
allow git commit -m "fix config edit flow in settings"
allow grep -rn claude-commit-signing src/ docs/
allow ls $XDG_RUNTIME_DIR/claude-commit-signing
allow rg "git config --global --unset commit.gpgsign" docs
allow grep -n 'git config commit.gpgsign false' README.md
allow cat >> README.md <<'EOF'{NL}Run git config --global commit.gpgsign false to turn it off.{NL}EOF
allow HOME=$(mktemp -d) zsh -c 'source ~/.zshrc && echo ok'
allow tmp=$(mktemp -d); HOME=$tmp sh src/install.sh && HOME=$tmp zsh -i -c exit
allow HOME=$(mktemp -d) bash -c "sh src/install.sh"
