allow cp src/modules/git/templates/.gitconfig "$tmp/.gitconfig"
allow git grep -c gpgsign
allow git config --unset core.hooksPath
allow git config user.signingkey 2>/dev/null
allow git config --show-origin gpg.format | cat
allow GIT_CONFIG_GLOBAL=/dev/null git status

