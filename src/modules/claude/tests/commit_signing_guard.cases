allow git config --global commit.gpgsign true
allow git -c commit.gpgsign=true commit -m x
allow git rebase --no-gpg-sign-please
allow shellcheck .claude/hooks/no-gpg.sh
deny git commit-tree -p HEAD -m x abc123
allow git commit-tree -S -p HEAD -m x abc123
