deny sed -i 's/gpgsign = true/gpgsign = false/' ~/.gitconfig
deny printf '...' | tee -a ~/.config/git/config
deny git tag --no-sign -a v1 -m v1
deny git mktag < t
deny git hash-object -t commit -w --stdin < c
deny git fast-import < stream
deny git stash create
deny git replay --onto main main..side
deny git filter-branch --msg-filter cat HEAD
deny sh -c 'git -c commit.gpgsign=false commit -m x'
