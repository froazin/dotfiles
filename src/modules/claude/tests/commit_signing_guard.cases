# Cases for test_commit_signing_guard.py, one per line. Blank lines and
# lines starting with "#" are ignored. In commands, {NL} is a newline (so a
# literal \n stays as typed, e.g. in printf); in post-event output, \n and \r
# are a newline and a carriage return.
#
#   deny <command>          PreToolUse Bash, unlocked session: must be denied
#   allow <command>         ... must be allowed
#   locked-deny <command>   PreToolUse Bash after a signing failure
#   locked-allow <command>
#   lock <Event> <command> ||| <output>   PostToolUse(Failure): must lock
#   none <Event> <command> ||| <output>   ... must not lock
#
# Paths: HOME is /home/u during the tests.

# --- PreToolUse
deny git commit --no-gpg-sign -m x
deny git commit -m x --no-gpg
deny git merge --no-g side
deny git rebase --no-gpg-sign main
deny git -c commit.gpgsign=false commit -m x
deny git -c Commit.GpgSign=0 commit -m x
deny git -c "commit.gpgsign=false" commit -m x
deny git -c 'gpg.ssh.program=ssh-keygen' -c user.signingkey=~/.ssh/id commit
deny git --config-env=commit.gpgsign=V commit
deny git --config-env commit.gpgsign=V commit
deny GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=commit.gpgsign GIT_CONFIG_VALUE_0=false git commit -m x
deny export GIT_CONFIG_PARAMETERS="'commit.gpgsign'='false'"; git commit -m x
deny env GIT_CONFIG_GLOBAL=/dev/null git commit -m x
deny git config commit.gpgsign false
deny git config --global commit.gpgSign false
deny git config set --global commit.gpgsign false
deny git config --global --unset commit.gpgsign
deny git config unset --global commit.gpgsign
deny git config --global --remove-section commit
deny git config --local include.path /tmp/evil
deny git config includeIf.gitdir:~/x/.path /tmp/evil
allow git config alias.ci "commit --no-verify"
