packages:
  # dotfiles modules and their soft and optional dependencies
  - zsh
  - zsh-common
  - zsh-autosuggestions
  - zsh-syntax-highlighting
  - fzf
  - git
  - direnv
  - xdg-utils
  - curl
  - ca-certificates
  - jq
  - python3
  # development
  - gh
  # VS Code's launcher fetches its WSL server with wget; ubuntu-wsl only pulls
  # it in indirectly.
  - wget
  - shellcheck
  - shfmt
  # containers
  - podman
  - podman-docker
  - podman-compose
  - buildah
  - skopeo
  # utilities
  - btop
  - nmap
  - ncat
  # virtualisation; qemu-kvm is a virtual package and must not be listed
  - qemu-system-x86
  - qemu-utils
  - libvirt-daemon-system
  - libvirt-clients
  - virtinst
  - ovmf
  - swtpm
  - swtpm-tools
  - cpu-checker

write_files:
  # No [user] section: the OOBE adds `default=` for whichever user exists.
  - path: /etc/wsl.conf
    permissions: "0644"
    content: |
      [boot]
      systemd=true
      command=mount -o remount,shared /

      [interop]
      enabled=true
      appendWindowsPath=false

  # Ubuntu Pro pins ESM at 510, which would otherwise win over upstream gh.
  - path: /etc/apt/preferences.d/github-cli
    permissions: "0644"
    content: |
      Package: gh
      Pin: origin cli.github.com
      Pin-Priority: 600

  # For a user the OOBE creates. DSHELL is added in runcmd, once zsh is known
  # to be installed.
  - path: /etc/adduser.conf
    append: true
    content: |

      # Added by cloud-init for WSL.
      ADD_EXTRA_GROUPS=1
      EXTRA_GROUPS="users kvm libvirt"

  - path: /etc/containers/nodocker
    permissions: "0644"
    content: ""

  # xdg-open falls back to $BROWSER when explorer.exe is not on PATH.
  - path: /etc/profile.d/browser.sh
    permissions: "0644"
    content: |
      export BROWSER=/usr/local/bin/start

  - path: /etc/environment.d/90-browser.conf
    permissions: "0644"
    content: |
      BROWSER=/usr/local/bin/start

  # .wslconfig sets swap=0, but swap that WSL attaches anyway is turned off.
  - path: /etc/systemd/system/disable-swap.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Disable swap to mirror swap=0 in .wslconfig
      ConditionVirtualization=wsl
      After=local-fs.target

      [Service]
      Type=oneshot
      ExecStart=/usr/sbin/swapoff -a
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target

  # runcmd enables podman.socket globally. In root's user manager, which
  # `sudo su` starts, it would be a second rootful API beside the system one.
  - path: /etc/systemd/user/podman.socket.d/10-not-root.conf
    permissions: "0644"
    content: |
      [Unit]
      ConditionUser=!root

  # Podman wants / shared; backs up the [boot] command in wsl.conf.
  - path: /etc/systemd/system/make-root-rshared.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Make / a recursively shared mount
      ConditionVirtualization=wsl
      DefaultDependencies=no
      After=local-fs.target
      Before=sysinit.target

      [Service]
      Type=oneshot
      ExecStart=/usr/bin/mount --make-rshared /
      RemainAfterExit=yes

      [Install]
      WantedBy=sysinit.target

  - path: /usr/local/bin/start
    permissions: "0755"
    content: |
      #!/usr/bin/sh
      #
      # Open a URL or file with its default Windows handler. Used as $BROWSER.

      _target="$*"

      if [ -e "$_target" ]; then
      	_target="$(wslpath -w "$_target")" || exit 1
      fi

      # Passed in the environment, not the command, so it is never parsed as code.
      # shellcheck disable=SC2016 # $env: is expanded by PowerShell, not sh.
      START_TARGET="$_target" WSLENV="${WSLENV:+$WSLENV:}START_TARGET" \
      	/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe \
      	-NoLogo \
      	-NoProfile \
      	-NonInteractive \
      	-Command 'Start-Process -FilePath $env:START_TARGET' \
      	</dev/null >/dev/null 2>&1 &

      exit 0

{% if user %}
  # Deferred until the user exists. The git module adds core.excludesfile later.
  - path: /home/{{ user }}/.gitconfig
    owner: "{{ user }}:{{ user }}"
    permissions: "0644"
    defer: true
    content: |
{% if git_name or git_email or git_signingkey %}
      [user]
{% if git_name %}
      	name = {{ gitval(git_name) }}
{% endif %}
{% if git_email %}
      	email = {{ gitval(git_email) }}
{% endif %}
{% if git_signingkey %}
      	signingkey = {{ gitval(git_signingkey) }}
{% endif %}
{% endif %}
      [init]
      	defaultBranch = main
      [core]
      	autocrlf = false
      	editor = /usr/local/bin/code --wait
      [safe]
      	directory = /home/{{ user }}/workspaces/*
      [credential "https://github.com"]
      	helper =
      	helper = !/usr/bin/gh auth git-credential
      [credential "https://gist.github.com"]
      	helper =
      	helper = !/usr/bin/gh auth git-credential
{% if git_signingkey %}
      [gpg]
      	format = ssh
      [commit]
      	gpgsign = true
{% endif %}
{% if git_ssh_program or allowed_signer %}
      [gpg "ssh"]
{% if git_ssh_program %}
      	program = {{ gitval(git_ssh_program) }}
{% endif %}
{% if allowed_signer %}
      	allowedSignersFile = ~/.config/git/allowed_signers
{% endif %}
{% endif %}
{% if allowed_signer %}

  # Lets git verify commits signed with git_signingkey. Parent directories
  # cloud-init creates here are owned by the user too.
  - path: /home/{{ user }}/.config/git/allowed_signers
    owner: "{{ user }}:{{ user }}"
    permissions: "0644"
    defer: true
    content: |
      {{ allowed_signer }}
{% endif %}
{% if wow_repo %}

  # The dotfiles' zsh config clones this repository on the first login, asking
  # gh to log in when it's private, and copies its user-config/ into ~/.claude.
  - path: /home/{{ user }}/.config/ways-of-working/repo
    owner: "{{ user }}:{{ user }}"
    permissions: "0644"
    defer: true
    content: |
      {{ wow_repo }}
{% endif %}
{% endif %}

# Runs in the final stage, after packages. Each entry runs regardless of the
# others' exit status.
runcmd:
  - [ln, -sfn, "/mnt/c/Program Files/Microsoft VS Code/bin/code", /usr/local/bin/code]
  - [ln, -sfn, "/mnt/c/Program Files/WinGet/Links/op.exe", /usr/local/bin/op]
  - [ln, -sfn, "/mnt/c/Program Files/OpenSSH/ssh.exe", /usr/local/bin/ssh]
  - [ln, -sfn, "/mnt/c/Program Files/OpenSSH/ssh-add.exe", /usr/local/bin/ssh-add]
  - [ln, -sfn, /mnt/c/Windows/System32/clip.exe, /usr/local/bin/clip]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, disable-swap.service, make-root-rshared.service]
  # Not `systemctl --user`: runcmd has no user bus. Keep this above the first
  # `runuser -l`, which starts the user's manager, the only time it reads
  # global wants.
  - [systemctl, --global, enable, podman.socket]
  # Root's API; podman-docker's /run/docker.sock points at it.
  - [systemctl, enable, --now, podman.socket]
  - [virsh, --connect, "qemu:///system", net-autostart, default]
  # A login shell that does not exist would lock the OOBE-created user out.
  - [sh, -c, 'if [ -x /usr/bin/zsh ]; then printf "DSHELL=/usr/bin/zsh\n" >> /etc/adduser.conf; fi']
  # Root too; `users:` skips existing users. Same guard as above.
  - [sh, -c, 'if [ -x /usr/bin/zsh ]; then usermod -s /usr/bin/zsh root; fi']
{% if user %}
  - [usermod, -aG, libvirt, "{{ user }}"]
  # Layout the zsh `ws` picker expects: ~/workspaces/<host>/<owner>/<repo>.
  - [runuser, -u, "{{ user }}", --, mkdir, -p, "/home/{{ user }}/workspaces"]
{% if gh_user %}
  - [runuser, -u, "{{ user }}", --, mkdir, -p, "/home/{{ user }}/workspaces/github.com/{{ gh_user }}"]
{% endif %}
  # Official installers, run as the user so they can update themselves. The
  # dotfiles' .zshenv puts ~/.local/bin and ~/.pulumi/bin on PATH.
  - [runuser, -l, "{{ user }}", -c, "curl -LsSf https://astral.sh/uv/install.sh | env UV_NO_MODIFY_PATH=1 sh"]
  - [runuser, -l, "{{ user }}", -c, "curl -fsSL https://get.pulumi.com | sh -s -- --no-edit-path"]
  # nvm's install.sh installs its own pinned release into ~/.nvm, so check out
  # the newest tag first; rerunning this updates it. PROFILE=/dev/null keeps it
  # out of the shell profiles.
  - [runuser, -l, "{{ user }}", -c, 'if [ -d {{ nvm_dir }}/.git ]; then git -C {{ nvm_dir }} fetch --quiet --tags; else git clone --quiet {{ nvm_repo }} {{ nvm_dir }}; fi && cd {{ nvm_dir }} && git checkout --quiet "$(git describe --abbrev=0 --tags --match "v[0-9]*" "$(git rev-list --tags --max-count=1)")" && PROFILE=/dev/null bash install.sh']
  # Claude Code's installer needs bash.
  - [runuser, -l, "{{ user }}", -c, "curl -fsSL https://claude.ai/install.sh | bash"]
  # ant (Claude Platform CLI, not apt's Apache Ant) has no installer or
  # self-update; rerunning this updates it. tar -m stamps the install time,
  # which is how zsh knows to regenerate its completion.
  - [runuser, -l, "{{ user }}", -c, 'v="$(curl -fsSLI -o /dev/null -w "%{url_effective}" https://github.com/anthropics/anthropic-cli/releases/latest)" && v="${v##*/v}" && case "$(uname -m)" in x86_64) a=amd64 ;; aarch64) a=arm64 ;; esac && mkdir -p ~/.local/bin && curl -fsSL "https://github.com/anthropics/anthropic-cli/releases/download/v$v/ant_${v}_linux_$a.tar.gz" | tar -xzmf - -C ~/.local/bin ant']
  # One entry each so one failure does not stop the rest. VS Code's launcher
  # only installs into ~/.vscode-server when WSL_DISTRO_NAME is set, which
  # runuser clears; the value only labels the remote, so the instance name from
  # wslpath will do.
{% for ext in extensions.valid %}
  - [runuser, -l, "{{ user }}", -c, '[ -x /usr/local/bin/code ] || exit 0; WSL_DISTRO_NAME="$(basename "$(wslpath -am /)")" code --install-extension {{ ext }}']
{% endfor %}
{# ASCII first: tojson writes non-BMP characters as surrogate pairs, which YAML decodes to lone surrogates that fail all of runcmd. printf, not echo: dash's echo interprets backslashes. #}
{% for ext in extensions.invalid %}
  - [printf, "Skipped vscode_extensions entry, not a publisher.name ID: %s\n", {{ ext.encode('ascii', 'backslashreplace').decode('ascii') | tojson }}]
{% endfor %}
{% if ways_of_working and not wow_repo %}
  - [printf, "Skipped ways_of_working, not a single URL: %s\n", {{ (ways_of_working | string).encode('ascii', 'backslashreplace').decode('ascii') | tojson }}]
{% endif %}
  # ~/.zshenv does not exist yet, so PATH gets its directories here; otherwise
  # the installer cannot see claude and skips the claude module.
  - [runuser, -l, "{{ user }}", -c, "{ [ -d {{ dotfiles_dir }}/.git ] || git clone {{ dotfiles_repo }} {{ dotfiles_dir }}; } && PATH=\"$HOME/.local/bin:$HOME/.pulumi/bin:$PATH\" sh {{ dotfiles_dir }}/src/install.sh"]
  # runcmd has no HOME; runuser -l sets HOME=/root, so the path cannot use ~.
  - [runuser, -l, root, -c, "sh /home/{{ user }}/{{ dotfiles_rel }}/src/install.sh"]
{% else %}
  # No user yet. The installer copies its templates, so the clone can be deleted.
  - [runuser, -l, root, -c, 'd="$(mktemp -d)" && git clone --quiet --depth 1 {{ dotfiles_repo }} "$d" && sh "$d/src/install.sh"; rc=$?; rm -rf "$d"; exit "$rc"']
{% endif %}
