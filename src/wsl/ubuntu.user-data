## template: jinja
#cloud-config

# Copy to %USERPROFILE%\.cloud-init\ubuntu.user-data, alongside a filled-in
# copy of src/wsl/ubuntu.meta-data, before installing the distro. It applies
# once, on first boot, and the OOBE waits for it.

{% set user = ds.meta_data.username or '' %}
{% set git_name = ds.meta_data.git_name or '' %}
{% set git_email = ds.meta_data.git_email or '' %}
{% set git_signingkey = ds.meta_data.git_signingkey or '' %}
{% if git_signingkey is string %}
{% set git_signingkey = git_signingkey.strip() %}
{% endif %}
{% set git_ssh_program = ds.meta_data.git_ssh_program or '' %}
{% set vscode_extensions = ds.meta_data.vscode_extensions or [] %}
{% if vscode_extensions is string %}
{% set vscode_extensions = vscode_extensions.replace(',', ' ').split() %}
{% elif vscode_extensions is mapping or vscode_extensions is not sequence %}
{% set vscode_extensions = [] %}
{% endif %}
{# Only publisher.name IDs, each part [A-Za-z0-9][A-Za-z0-9-]*, reach the shell. #}
{% set extensions = namespace(valid=[], invalid=[]) %}
{% for ext in vscode_extensions %}
{% set publisher, dot, name = (ext | string).partition('.') %}
{% if ext is string and dot and publisher[:1].isalnum() and name[:1].isalnum() and (publisher ~ name).isascii() and (publisher ~ name).replace('-', '').isalnum() %}
{% set extensions.valid = extensions.valid + [ext] %}
{% else %}
{% set extensions.invalid = extensions.invalid + [ext | string] %}
{% endif %}
{% endfor %}
{% set ways_of_working = ds.meta_data.ways_of_working or '' %}
{% if ways_of_working is string %}
{% set ways_of_working = ways_of_working.strip() %}
{% endif %}
{# Written into a YAML block, so only one word of printable ASCII gets through. The zsh config checks that it's a clone URL. #}
{% set wow_repo = ways_of_working if ways_of_working is string and ways_of_working.isascii() and ways_of_working.isprintable() and ' ' not in ways_of_working else '' %}
{# GitHub username from a noreply address, ID+user@ or user@. #}
{% set gh_local, _, gh_domain = (git_email | string).rpartition('@') %}
{% set gh_user = gh_local.split('+', 1)[-1] if gh_domain | lower == 'users.noreply.github.com' else '' %}
{% if not gh_user.replace('-', '').isalnum() %}
{% set gh_user = '' %}
{% endif %}
{# allowed_signers line for a key git reads as literal, "key::<type> <base64> [comment]" or "ssh-<type> ..."; anything else is a key file path to git and gets none. The principal is git_email, or * when it has characters outside [A-Za-z0-9.+_@-]. #}
{% set literal_key = git_signingkey is string and git_signingkey.startswith(('key::', 'ssh-')) %}
{% set key_type, key_data = ((git_signingkey | string).removeprefix('key::').split() + ['', ''])[:2] %}
{% set principal = git_email | string %}
{% if not (principal.isascii() and principal.replace('.', '').replace('+', '').replace('_', '').replace('-', '').replace('@', '').isalnum()) %}
{% set principal = '*' %}
{% endif %}
{% set allowed_signer = '' %}
{% if literal_key and key_type.startswith(('ssh-', 'ecdsa-', 'sk-')) and (key_type ~ key_data).isascii() and key_type.replace('-', '').replace('@', '').replace('.', '').isalnum() and key_data.replace('+', '').replace('/', '').replace('=', '').isalnum() %}
{% set allowed_signer = principal ~ ' namespaces="git" ' ~ key_type ~ ' ' ~ key_data %}
{% endif %}
{% macro workspace(repo) %}workspaces/{{ repo.split('://', 1)[-1].removesuffix('.git') }}{% endmacro %}
{% set dotfiles_repo = 'https://github.com/froazin/dotfiles.git' %}
{% set dotfiles_rel = workspace(dotfiles_repo) %}
{% set dotfiles_dir = '~/' ~ dotfiles_rel %}
{% set nvm_repo = 'https://github.com/nvm-sh/nvm.git' %}
{% set nvm_dir = '~/' ~ workspace(nvm_repo) %}
{% macro gitval(value) %}"{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') }}"{% endmacro %}

locale: en_GB.UTF-8
{% if user %}

users:
  - name: {{ user }}
    uid: 1000
    shell: /usr/bin/zsh
    groups: [adm, cdrom, sudo, dip, plugdev, users, kvm]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
{% endif %}

package_update: true
package_upgrade: true

apt:
  sources:
    github-cli:
      source: "deb [signed-by=$KEY_FILE] https://cli.github.com/packages stable main"
      # GitHub CLI <opensource+cli@github.com>
      # 7F38 BBB5 9D06 4DBC B3D8  4D72 5612 B364 6231 3325
