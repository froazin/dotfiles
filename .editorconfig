root = true

[*.sh]
indent_style = space
indent_size = 4

shell_variant      = posix  # Maps to: -ln=posix
binary_next_line   = true   # Maps to: -bn
switch_case_indent = true   # Maps to: -ci
space_redirects    = true   # Maps to: -sr
function_next_line = true   # Maps to: -fn

[src/modules/zsh/templates/**]
ignore = true

# uv's virtualenv: third-party scripts (node, npm) that are not ours to format.
[.venv/**]
ignore = true
