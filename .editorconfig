root = true

[*.sh]
indent_style = space
indent_size = 4

shell_variant = posix
binary_next_line = true
switch_case_indent = true
space_redirects = true
function_next_line = true

# zsh, which shfmt cannot parse
[src/modules/zsh/templates/**]
ignore = true

[.venv/**]
ignore = true

[*.{ps1,psd1}]
indent_style = space
indent_size = 4
end_of_line = lf
# ASCII only in practice: Windows PowerShell 5.1 reads a file without a BOM
# as ANSI.
charset = utf-8
