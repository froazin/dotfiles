# Based on https://github.com/github/gitignore/blob/main/Python.gitignore

logs
*.log

# Claude Code (.wow is a local ways of working opt-in marker)
**/settings.local.json
.claude/worktrees
.wow

# Environments
.env
.env.*
*.env
*.env.*
!.env.example

# Python virtual environments
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Not a package, so the lockfile is not needed
uv.lock

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
coverage.xml
*.cover
*.py.cover
*.lcov
.pytest_cache/

# Translations
*.mo
*.pot
cython_debug/

# Ruff cache
.ruff_cache/
